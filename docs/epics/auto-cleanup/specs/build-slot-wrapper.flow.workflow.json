{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "整段构建脚本接入项目入口",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "output": "build-slot-wrapper.html"
  },
  "lanes": [
    {
      "id": "dev",
      "label": "开发者或验收流程"
    },
    {
      "id": "wrap",
      "label": "包装命令"
    },
    {
      "id": "guard",
      "label": "锁与检查",
      "variant": "exception"
    },
    {
      "id": "cache",
      "label": "受管缓存"
    }
  ],
  "phases": [
    {
      "id": "start",
      "label": "发起构建",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "build",
      "label": "在固定缓存里构建",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "reclaim",
      "label": "按期回收",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "cmd",
    "slot",
    "lock",
    "script",
    "done"
  ],
  "nodes": [
    {
      "id": "cmd",
      "lane": "dev",
      "col": 0,
      "type": "external",
      "label": "用项目入口跑脚本",
      "sublabel": "平台 + 配置 + 变量名",
      "width": 140
    },
    {
      "id": "slot",
      "lane": "wrap",
      "col": 1,
      "type": "backend",
      "label": "找到固定那份缓存",
      "sublabel": "同任务同配置不变",
      "width": 140
    },
    {
      "id": "offline",
      "lane": "guard",
      "col": 1,
      "type": "security",
      "label": "缓存盘没连接",
      "sublabel": "明确报错",
      "width": 132
    },
    {
      "id": "lock",
      "lane": "guard",
      "col": 2,
      "type": "security",
      "label": "独占这份缓存",
      "sublabel": "别人在用就排队",
      "width": 132
    },
    {
      "id": "script",
      "lane": "wrap",
      "col": 3,
      "type": "backend",
      "label": "运行整段构建脚本",
      "sublabel": "环境变量给出缓存位置",
      "width": 150
    },
    {
      "id": "store",
      "lane": "cache",
      "col": 3,
      "type": "database",
      "label": "固定缓存",
      "sublabel": "第二次增量编译",
      "width": 132
    },
    {
      "id": "done",
      "lane": "dev",
      "col": 4,
      "type": "external",
      "label": "原样拿到结果",
      "sublabel": "退出码和输出不变",
      "width": 140
    },
    {
      "id": "gc",
      "lane": "cache",
      "col": 5,
      "type": "database",
      "label": "过期中间文件回收",
      "sublabel": "1.3 已有，锁住的不动",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "cmd",
      "to": "slot",
      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "slot",
      "to": "offline",
      "label": "盘不在",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e3",
      "from": "slot",
      "to": "lock",
      "variant": "emphasis"
    },
    {
      "id": "e4",
      "from": "lock",
      "to": "script",
      "variant": "emphasis"
    },
    {
      "id": "e5",
      "from": "script",
      "to": "store",
      "label": "读写",
      "variant": "dashed"
    },
    {
      "id": "e6",
      "from": "script",
      "to": "done",
      "label": "释放锁",
      "variant": "emphasis"
    },
    {
      "id": "e7",
      "from": "store",
      "to": "gc",
      "label": "超过保留期",
      "variant": "dashed",
      "role": "branch",
      "fromSide": "bottom",
      "toSide": "bottom",
      "route": "bottom-channel"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "接入条件",
      "items": [
        "项目已用 1.3 接入",
        "脚本支持用环境变量指定缓存位置",
        "不用改项目自己的脚本"
      ]
    }
  ]
}
