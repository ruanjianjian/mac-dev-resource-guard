{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "分档自动清理全景（基于 1.3）",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "output": "overview.html"
  },
  "lanes": [
    {
      "id": "user",
      "label": "用户"
    },
    {
      "id": "auto",
      "label": "自动档"
    },
    {
      "id": "ask",
      "label": "询问档",
      "variant": "exception"
    },
    {
      "id": "build",
      "label": "构建缓存"
    }
  ],
  "phases": [
    {
      "id": "watch",
      "label": "盯空间",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "sort",
      "label": "按风险分档",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "done",
      "label": "处理并留记录",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "enable",
    "tick",
    "auto_do",
    "log"
  ],
  "nodes": [
    {
      "id": "enable",
      "lane": "user",
      "col": 0,
      "type": "external",
      "label": "打开自动清理",
      "sublabel": "一次授权",
      "width": 132
    },
    {
      "id": "tick",
      "lane": "auto",
      "col": 1,
      "type": "backend",
      "label": "每 30 分钟查空间",
      "sublabel": "接在 1.3 定时任务上",
      "width": 132
    },
    {
      "id": "auto_do",
      "lane": "auto",
      "col": 3,
      "type": "database",
      "label": "挪目录 / 删产物",
      "sublabel": "不丢任何东西",
      "width": 140
    },
    {
      "id": "ask_list",
      "lane": "ask",
      "col": 3,
      "type": "security",
      "label": "待确认列表",
      "sublabel": "会丢登录状态或目录",
      "width": 140
    },
    {
      "id": "confirm",
      "lane": "user",
      "col": 4,
      "type": "external",
      "label": "勾选确认",
      "sublabel": "执行前再核对",
      "width": 132
    },
    {
      "id": "log",
      "lane": "user",
      "col": 5,
      "type": "frontend",
      "label": "看板记录",
      "sublabel": "清了什么、腾出多少",
      "width": 140
    },
    {
      "id": "slot",
      "lane": "build",
      "col": 2,
      "type": "backend",
      "label": "整段脚本用固定缓存",
      "sublabel": "扩展 1.3 项目入口",
      "width": 132
    },
    {
      "id": "gc",
      "lane": "build",
      "col": 4,
      "type": "database",
      "label": "过期中间文件回收",
      "sublabel": "1.3 已有",
      "width": 140
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "enable",
      "to": "tick",
      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "tick",
      "to": "auto_do",
      "label": "安全的",
      "variant": "emphasis"
    },
    {
      "id": "e3",
      "from": "tick",
      "to": "ask_list",
      "label": "有风险的",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "e4",
      "from": "ask_list",
      "to": "confirm",
      "label": "通知",
      "variant": "dashed"
    },
    {
      "id": "e5",
      "from": "confirm",
      "to": "log",
      "variant": "dashed"
    },
    {
      "id": "e6",
      "from": "auto_do",
      "to": "log",
      "variant": "emphasis"
    },
    {
      "id": "e7",
      "from": "slot",
      "to": "gc",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "1.3 已有",
      "items": [
        "每 12 小时清过期 Xcode 中间缓存",
        "项目入口包一条 xcodebuild"
      ]
    },
    {
      "dot": "rose",
      "title": "永不档",
      "items": [
        "未提交或未推送的改动",
        "正在用、受保护的内容"
      ]
    }
  ]
}
